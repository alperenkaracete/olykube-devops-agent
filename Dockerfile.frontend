FROM python:3.12-slim

# Resmi uv imajından uv binary'sini kopyalayalım (En hızlı ve temiz yöntem)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Sadece frontend dosyasını kopyalıyoruz
COPY frontend.py .

# uv kullanarak paketleri sistem geneline (Docker içi) kuralım
RUN uv pip install --system streamlit==1.35.0 requests

# Streamlit'in varsayılan portu
EXPOSE 8501

# Streamlit'i dışarıdan erişilebilir (0.0.0.0) şekilde başlat
CMD ["streamlit", "run", "frontend.py", "--server.port=8501", "--server.address=0.0.0.0"]