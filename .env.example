# LLM (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Embedding (Google Gemini)
GOOGLE_API_KEY=

# Web araması
TAVILY_API_KEY=

# PostgreSQL (db container'ı bu değerlerle oluşturulur)
POSTGRES_USER=olykube
POSTGRES_PASSWORD=change-me
POSTGRES_DB=olykube

# API'nin bağlanacağı adres. Docker Compose: host "db", yerel geliştirme: "localhost"
PG_DSN=postgresql://olykube:change-me@db:5432/olykube

